	partition MeshBlocks = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("tables/meshblocks.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"mb", "suburb", "district", "category", "dwellings", "residents", "children", "network_m", "reached_m", "straight_m", "pct_streets_walk5", "pct_streets_line5", "pct_streets_walk10", "children_walk5", "children_line5", "children_walk10", "walk_band", "lat", "lng"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"mb", type text}, {"suburb", type text}, {"district", type text}, {"category", type text}, {"dwellings", Int64.Type}, {"residents", Int64.Type}, {"children", type number}, {"network_m", Int64.Type}, {"reached_m", Int64.Type}, {"straight_m", Int64.Type}, {"pct_streets_walk5", type number}, {"pct_streets_line5", type number}, {"pct_streets_walk10", type number}, {"children_walk5", type number}, {"children_line5", type number}, {"children_walk10", type number}, {"walk_band", type text}, {"lat", type number}, {"lng", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
