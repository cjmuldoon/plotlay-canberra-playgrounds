table MeshBlocks
	lineageTag: 8237165a-80c9-2b5c-531d-008ae7917017

	/// Children aged 0 to 14 (each mesh block’s residents times its SA1’s share aged 0 to 14)
	measure 'All children' = SUM ( MeshBlocks[children] )
		formatString: #,0
		lineageTag: 9a878128-fabb-7fe3-8576-d4d8e14ce3d0

	/// Children within a 5-minute walk (400 m along the paths) of a playground
	measure 'Children within the walk' = SUM ( MeshBlocks[children_walk5] )
		formatString: #,0
		lineageTag: 690a2ef8-1d00-a9e7-41e8-da90e3b7befb

	/// The share of children within a 5-minute walk
	measure 'Share within the walk' = DIVIDE ( [Children within the walk], [All children] )
		formatString: 0.0%
		lineageTag: 2b95bcf1-cafe-c82f-defe-2c414653c0f9

	/// The share of children within 400 m in a straight line
	measure 'Share as the crow flies' = DIVIDE ( SUM ( MeshBlocks[children_line5] ), [All children] )
		formatString: 0.0%
		lineageTag: 575daba1-ef79-3ff2-66b7-71d609b2ba27

	/// The share of children within a 10-minute walk (800 m)
	measure 'Share within 10 minutes' = DIVIDE ( SUM ( MeshBlocks[children_walk10] ), [All children] )
		formatString: 0.0%
		lineageTag: dba7c2ef-0418-9cad-618f-d9657d0dff94

	/// Mesh blocks with residents
	measure 'Mesh block count' = COUNTROWS ( MeshBlocks )
		formatString: #,0
		lineageTag: e7a204ef-2c27-aada-2289-ec2f7bcb48f3

