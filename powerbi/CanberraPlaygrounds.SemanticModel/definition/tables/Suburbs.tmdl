	partition Suburbs = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("tables/suburbs.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"suburb", "children", "residents", "children_walk5", "children_line5", "children_walk10", "pct_walk5", "pct_line5", "pct_walk10", "gap_pts", "playgrounds", "compared"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"suburb", type text}, {"children", Int64.Type}, {"residents", Int64.Type}, {"children_walk5", Int64.Type}, {"children_line5", Int64.Type}, {"children_walk10", Int64.Type}, {"pct_walk5", type number}, {"pct_line5", type number}, {"pct_walk10", type number}, {"gap_pts", type number}, {"playgrounds", Int64.Type}, {"compared", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
