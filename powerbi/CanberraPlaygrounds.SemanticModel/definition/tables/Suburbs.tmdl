table Suburbs
	lineageTag: 78368984-6814-5f0f-0156-58f4d5dfe55e

	/// For the suburb charts: children within the walk over children
	measure 'Suburb share within the walk' = DIVIDE ( SUM ( Suburbs[children_walk5] ), SUM ( Suburbs[children] ) )
		formatString: 0.0%
		lineageTag: 2a58bb7c-bc28-b185-efed-eaa124202f51

	/// Children within 400 m in a straight line over children
	measure 'Suburb share as the crow flies' = DIVIDE ( SUM ( Suburbs[children_line5] ), SUM ( Suburbs[children] ) )
		formatString: 0.0%
		lineageTag: c66cc6a6-de9b-14bb-7cda-6aaf5ce0911d

